<?php
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

$config = json_decode($block->getJsonConfig());
$rate = $config->rate ?? 1;
$min = floor($config->minValue * $rate);
$max = round($config->maxValue * $rate);
$from = $min;
$to = $max;

if ($config->currentValue && $config->currentValue->from) {
    $from = floor($config->currentValue->from * $rate);
}

if ($config->currentValue && $config->currentValue->to) {
    $to = round($config->currentValue->to * $rate);
}

?>

<div class="range-inputs" data-role="<?= $escaper->escapeHtmlAttr($block->getDataRole()) ?>">
    <div class="labels">
        <div data-role="from-label"><?= /* @noEscape */ $from ?></div>
        <div data-role="to-label"><?= /* @noEscape */ $to ?></div>
    </div>

    <range-slider min="<?= /* @noEscape */ $min ?>"
                  max="<?= /* @noEscape */ $max ?>"
                  value="<?= /* @noEscape */ $from . '-' . $to ?>">
        <input class="range"
               type="range"
               min="<?= /* @noEscape */ $min ?>"
               max="<?= /* @noEscape */ $max ?>"
               value="<?= /* @noEscape */ $from ?>"
               aria-label="<?= $escaper->escapeHtmlAttr(__('From')) ?>"/>
        <input class="range"
               type="range"
               min="<?= /* @noEscape */ $min ?>"
               max="<?= /* @noEscape */ $max ?>"
               value="<?= /* @noEscape */ $to ?>"
               aria-label="<?= $escaper->escapeHtmlAttr(__('To')) ?>"/>
        <input class="filler" disabled type="range"/>
    </range-slider>

    <div class="actions-toolbar">
        <div data-role="message-box"></div>
        <div class="actions-primary">
            <a class="action primary small" data-role="apply-range">
                <span><?= $escaper->escapeHtml(__('OK')) ?></span>
            </a>
        </div>
    </div>
</div>

<script type="text/x-magento-init">
    {
        "[data-role=<?= $escaper->escapeJs($block->getDataRole()) ?>]": {
            "rangeSlider": <?= /* @noEscape */ $block->getJsonConfig() ?>
        }
    }
</script>
